# 数据源：local = 浏览器 IndexedDB（Dexie，默认）；remote = REST API（Fastify 服务端）
VITE_DATA_SOURCE=local
# 仅 remote 生效：局域网 NAS 容器地址
VITE_API_BASE_URL=http://192.168.1.10:7788/api

# —— v0.6 · T14 备份通道鉴权（fail-closed）——
# 服务端：/api/backup 与 /api/backup/import 的共享密钥。未配置 = 备份端点全拒（401）。
# 生成建议：openssl rand -hex 32。请求方经 X-Agent-Token 头或 Authorization: Bearer 携带。
# ⚠ 此密钥是「NAS 迁移通道」专用；未来 Agent HTTP API 使用独立端点 + 独立 token，不复用本值。
IDPLAN_AGENT_TOKEN=
# 前端（仅 remote 模式）：与上同值时前端 RestClient 自动带 Authorization: Bearer。
VITE_API_TOKEN=
