# =====================================================================
# ID Plan · 后端服务镜像（Fastify + better-sqlite3）
#
# 为什么单独一个镜像：
#   前端镜像（Dockerfile）是 nginx 托管静态产物，跑不了 Node 后端；
#   后端需要 Node 运行时 + better-sqlite3（native 模块）。两者职责分离，
#   由 docker-compose 编排，前端经 nginx /api 反代访问后端。
#
# 为什么用 Debian slim 而不是 alpine：
#   better-sqlite3 是 native 模块，alpine 的 musl libc 与之兼容性差
#   （prebuilt 二进制多为 glibc，musl 下需完整编译且易踩坑）。
#   Debian slim + 完整编译工具链，在 amd64/arm64 上都能稳定构建。
#
# 构建（多架构，绿联 NAS 有 amd64 与 arm64 两种机型）：
#   docker buildx build --platform linux/amd64 -f ugnas/Dockerfile.backend -t idplan-backend:amd64 .
#   docker buildx build --platform linux/arm64 -f ugnas/Dockerfile.backend -t idplan-backend:arm64 .
# =====================================================================

FROM node:20-slim AS build
WORKDIR /app

# 编译工具链：better-sqlite3 优先用 prebuilt 二进制，
# 若无匹配版本（如 arm64 某些组合）则回落到 node-gyp 源码编译。
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 依赖优先缓存。
# lockfile 不含 electron/electron-builder/cross-env（桌面打包专用），与 package.json
# 不同步，npm ci 会报 EUSAGE；因此直接 npm install --include=optional，
# 确保 better-sqlite3（声明在 optionalDependencies）被装上——npm 默认会跳过 optional 依赖。
# 同时用 ELECTRON_SKIP_BINARY_DOWNLOAD=1 跳过 electron 二进制下载（后端不需要桌面运行时）。
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package.json package-lock.json* ./
RUN npm install --include=optional --no-audit --no-fund

# 拷贝后端源码（server/）**与它依赖的共享核心（src/）**
#
# ★ 2026-09-29 线上事故修复：server/ 自 b376a85（旅游行业）起大量 import
#   ../../src/...（payload.apply / enums / entities / stage-library / lib/date
#   等 30+ 处）。旧 Dockerfile 只 COPY server/，本地 tsx 从仓库根跑能解析
#   （src 在仓库里），容器里 /app 下没有 src ⇒ 启动即
#   ERR_MODULE_NOT_FOUND: /app/src/lib/date（0.8.0.0010 UPK 实机复现）。
#   src 全量COPY（含 .tsx 组件）无妨：tsx 按 import 逐文件解析，未引用的
#   文件只是躺在层里；产物 tar 侧同一修复见 scripts/patch_backend_tar.py。
COPY server/ ./server/
COPY src/ ./src/
# templates/：src/core/template/*.ts 静态 import 阶段库/九段骨架 json
# （stage-library.ts / nine-stages.ts），缺它容器同样启动即崩
COPY templates/ ./templates/

# ---------- 运行阶段 ----------
FROM node:20-slim
LABEL maintainer="chengcheng"

WORKDIR /app

# 运行期只需要 better-sqlite3 的 .node 产物与 fastify 等运行时依赖
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/server ./server
COPY --from=build /app/src ./src
COPY --from=build /app/templates ./templates
COPY package.json ./

# 数据目录：SQLite 单文件 + WAL 副文件都落这里，由 compose 挂卷持久化。
# 用环境变量 CHANGXIA_DB 可覆盖具体文件名（server/db.ts 已支持）。
ENV CHANGXIA_DB=/data/changxia.db
ENV PORT=7788
ENV HOST=0.0.0.0
ENV NODE_ENV=production

RUN mkdir -p /data && chmod 755 /data

# 声明数据卷：容器重建不丢库（绿联 Docker 应用会映射到 NAS 的共享文件夹）
VOLUME ["/data"]

EXPOSE 7788

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||7788)+'/api/settings').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" || exit 1

# 用 tsx 直接跑 TS 源码（与 npm run dev:server 同口径，免去编译步骤）。
# 后端体量小、启动一次常驻，tsx 的启动开销可接受；后续如需极致可改 tsc 预编译。
CMD ["node_modules/.bin/tsx", "server/index.ts"]
